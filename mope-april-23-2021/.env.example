# Local mope.io stack settings. Copy to .env and edit; every line is optional.
# Generated from services/settings.py -- run `python localstack.py check-config` to validate.


# ---- Account server ----------------------------------------------
# SQLite database for accounts, sessions, purchases and wardrobes (created and migrated on start).
ACCOUNT_DB_PATH=data/accounts.sqlite3
# Allow new local accounts to be created from the local login page.
ACCOUNT_REGISTRATION_ENABLED=true
# Allow logins (local accounts and, if enabled, test accounts).
ACCOUNT_LOGIN_ENABLED=true
# Shortest allowed local username. [1..15]
ACCOUNT_USERNAME_MIN_LENGTH=3
# Longest allowed local username (the client's name box holds 15 characters). [1..15]
ACCOUNT_USERNAME_MAX_LENGTH=15
# Shortest allowed password. [4..128]
ACCOUNT_PASSWORD_MIN_LENGTH=8
# How long a login token (the client's login_passwordToken) stays valid. [1..3650]
ACCOUNT_SESSION_TTL_DAYS=30
# Failed logins per username before it is locked for ACCOUNT_LOGIN_LOCKOUT_MINUTES. [1..1000]
ACCOUNT_LOGIN_MAX_FAILURES=10
# Lockout duration after too many failed logins. [1..1440]
ACCOUNT_LOGIN_LOCKOUT_MINUTES=15
# Coins given to a new account. [0..1000000000]
ACCOUNT_STARTING_COINS=0
# Gems given to a new account. [0..1000000000]
ACCOUNT_STARTING_GEMS=0
# Every account has unlimited coins and gems: the client is shown 999999999 of each and purchases are recorded without charging. The stored balances are kept (false restores them).
ACCOUNT_INFINITE_CURRENCY=true
# Serve the shop endpoints (/shop/get, /shop/purchases, /shop/buy, /shop/wardrobe/save).
ACCOUNT_SHOP_ENABLED=true
# Shop catalogue served by /shop/get (the archived catalogue was server-side and is not recoverable).
ACCOUNT_SHOP_CATALOG=config/shop_catalog.json
# Output of import_live_skins.rb. If it exists, its catalog.json items are added to /shop/get and the web gateway serves its skin pictures. Empty to turn off.
SHOP_LIVE_SKINS_DIR=snapshots/2025-12-10/live-skins

# ---- Client ------------------------------------------------------
# $config.env. 'development' enables the client's [DEV] error handler and shows updates of every env; 'development'/'staging' also switch its payment widget to the payment provider's sandbox. [production | staging | development]
CLIENT_ENV=production
# $config.isTestingMode: verbose client logging of account requests.
CLIENT_TESTING_MODE=false
# $config.isBetaMode: server-full thresholds 900/800 instead of 400/500.
CLIENT_BETA_MODE=false
# JSON served as /updates.json for the client's Updates panel.
WEB_UPDATES_FILE=config/updates.json

# ---- Developer ---------------------------------------------------
# Enable the client's test-account hook: http://local.mope.io:8080/?testAccountSecret=<secret>&user=<1-2 chars>.
DEV_TEST_ACCOUNTS_ENABLED=false
# Secret for the test-account hook (8-64 of A-Z a-z 0-9 _ -). Required when test accounts are enabled.
DEV_TEST_ACCOUNT_SECRET=
# Enable /addCoins and /resetAccount (called by the client in testing builds). Local use only.
DEV_ADMIN_ENDPOINTS_ENABLED=false
# Coins added by one /addCoins call. [1..10000000]
DEV_ADD_COINS_AMOUNT=1000

# ---- Sandbox -----------------------------------------------------
# Add the client's built-in sandbox server: name 'LOCAL', id 'localhost', region 'SANDBOX'.
SANDBOX_REGION_ENABLED=false
# Port of the sandbox region server. [1024..65535]
SANDBOX_REGION_PORT=7099

# ---- Remote backend ----------------------------------------------
# Base URL of a hosted backend (cloud.py, e.g. https://<app>.sevalla.app). When set, `localstack.py up` runs only the web gateway and a local WebSocket relay; accounts, the master and the regions are the remote ones.
REMOTE_BACKEND_URL=
# Access key the hosted backend asks for (its BACKEND_ACCESS_KEY). Leave empty if it has none.
REMOTE_BACKEND_KEY=
# Local port of the WebSocket relay that carries game traffic to the remote backend. [1024..65535]
REMOTE_RELAY_PORT=7000
